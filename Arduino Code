#include <Stepper.h>
#include <EEPROM.h>

// Constants 
const int stepsPerRevolution = 2038;//steps per rev for half stepping 
const float mmPerRev = 30.0;        // Motor 1 (C-arm)
const float mmPerRev_M2 = 20.0;     // Motor 2 (Table, 10-tooth gear)
const int EEPROM_SIZE = 64;//eeprom storage nsano 

// movement limits from my calcs - see doc

const float mmMin_M1 = -24.0; //minimum vertical position (up)
const float mmMax_M1 = 24.0;// max vert (down) - 
const float mmMin_M2 = -20.0; // min table travel distance in backward dorection i guess or line left if ur looking from side
const float mmMax_M2 = 25.0;//max distance of table to right 
const int degLimit_M3 = 60;         // ±60 degrees hopefully this is enough 

// PRESETS 
const int presetCount = 2;
long presetPositions[3][presetCount] = {
  //motor 3 - stand presets 
  { -80, 120 },   // rotatae left/right 
  //motor 1 - c carm
  { -100, 1000 }, // move up/down
  //table presets motor 2
  { -300, 800 }    // move left / right - or up down ig 
};

// === Motor Pins ===
//motor 3 - stand 
#define M3_IN1 10
#define M3_IN2 6
#define M3_IN3 8
#define M3_IN4 9
//motor 1 - c arm 
#define M1_IN1 2
#define M1_IN2 3
#define M1_IN3 4
#define M1_IN4 5
//motor2 - table table 
#define M2_IN1 7
#define M2_IN2 11
#define M2_IN3 12
#define M2_IN4 13

//stepper motor setip
//order the pins fire in 
Stepper motor3(stepsPerRevolution, M3_IN1, M3_IN3, M3_IN2, M3_IN4);
Stepper motor1(stepsPerRevolution, M1_IN1, M1_IN3, M1_IN2, M1_IN4);
Stepper motor2(stepsPerRevolution, M2_IN1, M2_IN3, M2_IN2, M2_IN4);
Stepper* motors[] = { &motor3, &motor1, &motor2 };//pointers for index control
String directions[3] = { "stop", "stop", "stop" }; // motor directions
bool stopRequested[3] = { false, false, false }; //emergency stop flag 
long currentPosition[3] = { 0, 0, 0 }; // current position in steps from home

//saving posiitions to EEPROM so that the last known position can be accoybred for 
void savePositionsToEEPROM() {
  for (int i = 0; i < 3; i++) {
    EEPROM.put(i * sizeof(long), currentPosition[i]);
  }
  EEPROM.commit();// special for esp 32 
}

void loadPositionsFromEEPROM() {
  for (int i = 0; i < 3; i++) {
    EEPROM.get(i * sizeof(long), currentPosition[i]);
  }
}
// map of motor number to the index  1= c arm , 2= table 3 = stand 
int getMotorIndexFromUserInput(int inputMotor) {
  if (inputMotor == 3) return 0;
  if (inputMotor == 1) return 1;
  if (inputMotor == 2) return 2;
  return -1;
}
// movinging motor to set number of steps  while polling for stop command
void moveWithStopInterrupt(int motorIndex, long stepsToMove) {
  int dir = (stepsToMove > 0) ? 1 : -1;
  long steps = abs(stepsToMove);
  Stepper& motor = *motors[motorIndex];

  while (steps-- > 0 && !stopRequested[motorIndex]) {
    motor.step(dir);
    currentPosition[motorIndex] += dir;

    if (Serial.available()) {
      String input = Serial.readStringUntil('\n');
      input.trim();
//emergency stop
      if (input == "stop" || input == "all,stop") {
        for (int i = 0; i < 3; i++) {
          directions[i] = "stop";
          stopRequested[i] = true;
        }
        Serial.println("EMERGENCY STOP Stopping all motors.");
        return;
      }

      String thisMotorStop = String((motorIndex == 0) ? 3 : (motorIndex == 1) ? 1 : 2) + ",stop";
      if (input == thisMotorStop) {
        stopRequested[motorIndex] = true;
        directions[motorIndex] = "stop";
        Serial.print("Motor ");
        Serial.print((motorIndex == 0) ? 3 : (motorIndex == 1) ? 1 : 2);
        Serial.println(" stopped by user.");
        return;
      }
    }
  }

  savePositionsToEEPROM();//after movment is complete it saves position to eeprom 
}

void setup() {
 
  Serial.begin(115200);
  EEPROM.begin(EEPROM_SIZE);
  loadPositionsFromEEPROM();

  for (int i = 0; i < 3; i++) {
    motors[i]->setSpeed(5);// setting speed 
  }
// upson supload startput this is printed 
  Serial.println("Stepper System Ready");
  Serial.println("Commands: 'motor#,c/cc/stop/goto:xx/preset:1/home/zero/pos'");
  Serial.println("           'pos' (all), 'stop' (all), 'all,stop'");
}

void loop() {
   //check if user input is avalibe over
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    input.trim();

    if (input == "stop" || input == "all,stop") {
      for (int i = 0; i < 3; i++) {
        directions[i] = "stop";
        stopRequested[i] = true;
      }
      Serial.println("All motors stopped.");
      return;
    }
// display current position of all motors 
    if (input == "pos") {
      Serial.println("--------------- Motor Positions ---------------");
      for (int i = 0; i < 3; i++) {
        long steps = currentPosition[i];
        Serial.print("Motor ");
        Serial.print((i == 0) ? 3 : (i == 1) ? 1 : 2);
        Serial.print(": ");
        Serial.print(steps);
        Serial.print(" steps (");
        if (i == 0) {
          float deg = (steps / (float)stepsPerRevolution) * 360.0;
          Serial.print(deg, 2);
          Serial.println(" °)");
        } else {
          float mm = (steps / (float)stepsPerRevolution) * (i == 2 ? mmPerRev_M2 : mmPerRev);
          Serial.print(mm, 2);
          Serial.println(" mm)");
        }
      }
      return;
    }

// in class demo 
   if (input == "demo") {
  Serial.println("=== Running Demo Sequence ===");

  // Step 1: Move to Preset 1
  Serial.println("Moving Table (Motor 2) to preset 1...");
  moveWithStopInterrupt(2, presetPositions[2][0] - currentPosition[2]);
delay(1000);
  Serial.println("Rotating Stand (Motor 3) to preset 1...");
  moveWithStopInterrupt(0, presetPositions[0][0] - currentPosition[0]);

  Serial.println("Moving C-arm (Motor 1) to preset 1...");
  moveWithStopInterrupt(1, presetPositions[1][0] - currentPosition[1]);
delay(1000); // wait a sec
  // Step 2: Move to Preset 2
  Serial.println("Moving Table (Motor 2) to preset 2...");
  moveWithStopInterrupt(2, presetPositions[2][1] - currentPosition[2]);
delay(2000); // wait a sec or 2
  Serial.println("Rotating Stand (Motor 3) to preset 2...");
  moveWithStopInterrupt(0, presetPositions[0][1] - currentPosition[0]);

  Serial.println("Moving C-arm (Motor 1) to preset 2...");
  moveWithStopInterrupt(1, presetPositions[1][1] - currentPosition[1]);

  // Step 3: Display current positions
  Serial.println("=== Final Positions After Demo ===");
  for (int i = 0; i < 3; i++) {
    Serial.print("Motor ");
    Serial.print((i == 0) ? 3 : (i == 1) ? 1 : 2);
    Serial.print(": ");
    Serial.print(currentPosition[i]);
    Serial.print(" steps (");
    if (i == 0) {
      float deg = (currentPosition[i] / (float)stepsPerRevolution) * 360.0;
      Serial.print(deg, 2);
      Serial.println(" °)");
    } else {
      float mm = (currentPosition[i] / (float)stepsPerRevolution) * (i == 2 ? mmPerRev_M2 : mmPerRev);
      Serial.print(mm, 2);
      Serial.println(" mm)");
    }
  }
  return;
}
/*end of in class demo*/

// checking for motor specific commands - using 1,2,or3 then comma to call those commands
    if (input.indexOf(',') != -1) {
      int commaIndex = input.indexOf(',');
      int inputMotor = input.substring(0, commaIndex).toInt();
      String cmd = input.substring(commaIndex + 1);
      cmd.trim();
      int motorIndex = getMotorIndexFromUserInput(inputMotor);

      if (motorIndex == -1) {
        Serial.println("Invalid motor index.");
        return;
      }
//printing position of specific motor 
      if (cmd == "pos") {
        long steps = currentPosition[motorIndex];
        Serial.print("Motor ");
        Serial.print(inputMotor);
        Serial.print(" position: ");
        Serial.print(steps);
        Serial.print(" steps (");
        if (motorIndex == 0) {
          float deg = (steps / (float)stepsPerRevolution) * 360.0;
          Serial.print(deg, 2);
          Serial.println(" °)");
        } else {
          float mm = (steps / (float)stepsPerRevolution) * (motorIndex == 2 ? mmPerRev_M2 : mmPerRev);
          Serial.print(mm, 2);
          Serial.println(" mm)");
        }
        return;
      }

//goto command that tells the motor where to move 
      if (cmd.startsWith("goto:")) {
        float targetMM = cmd.substring(5).toFloat();
        float mmPerRevUsed = (motorIndex == 2) ? mmPerRev_M2 : mmPerRev;
//checking to see if that request will be in bounds 

        if ((motorIndex == 1 && (targetMM < mmMin_M1 || targetMM > mmMax_M1)) ||
            (motorIndex == 2 && (targetMM < mmMin_M2 || targetMM > mmMax_M2))) {
          Serial.println("Target out of bounds.");
          return;
        }

        long targetSteps = (targetMM / mmPerRevUsed) * stepsPerRevolution;
        long stepsToMove = targetSteps - currentPosition[motorIndex];
        directions[motorIndex] = "stop";
        stopRequested[motorIndex] = false;
        moveWithStopInterrupt(motorIndex, stepsToMove);
        return;
      // preset commands to move motors to desgnated location using command move,
      } else if (cmd.startsWith("preset:")) {
        int presetNum = cmd.substring(7).toInt();

        if (presetNum < 1 || presetNum > presetCount) {
          Serial.println("Invalid preset number. Use 1 or 2.");
          return;
        }

        long targetSteps = presetPositions[motorIndex][presetNum - 1];
        long stepsToMove = targetSteps - currentPosition[motorIndex];

        bool outOfBounds = false;
        if (motorIndex == 0 && (targetSteps < -510 || targetSteps > 510)) {
          outOfBounds = true;
        } else if (motorIndex == 1) {
          float mm = (targetSteps / (float)stepsPerRevolution) * mmPerRev;
          if (mm < mmMin_M1 || mm > mmMax_M1) outOfBounds = true;
        } else if (motorIndex == 2) {
          float mm = (targetSteps / (float)stepsPerRevolution) * mmPerRev_M2;
          if (mm < mmMin_M2 || mm > mmMax_M2) outOfBounds = true;
        }

        if (outOfBounds) {
          Serial.println("Preset target is out of bounds.");
          return;
        }

        Serial.print("Moving Motor ");
        Serial.print(inputMotor);
        Serial.print(" to preset ");
        Serial.print(presetNum);
        Serial.print(" (");
        Serial.print(targetSteps);
        Serial.println(" steps)");

        directions[motorIndex] = "stop";
        stopRequested[motorIndex] = false;
        moveWithStopInterrupt(motorIndex, stepsToMove);
        return;
      }
// manual spinning commands - moves motor in clockwise or counter clockwise direction until it reaches out of bounds
      if (cmd == "c" || cmd == "cc") {
        directions[motorIndex] = cmd;
        stopRequested[motorIndex] = false;
        Serial.print("Motor ");
        Serial.print(inputMotor);
        Serial.print(" spinning ");
        Serial.println(cmd == "c" ? "clockwise" : "counterclockwise");
      } else if (cmd == "stop") {
        directions[motorIndex] = "stop";
        stopRequested[motorIndex] = true;
        Serial.print("Motor ");
        Serial.print(inputMotor);
        Serial.println(" stopped.");
      } 
      // manual zeroing of home position 
      else if (cmd == "zero" || cmd == "rezero") {
        currentPosition[motorIndex] = 0;
        savePositionsToEEPROM();
        Serial.print("Motor ");
        Serial.print(inputMotor);
        Serial.println(" manually zeroed.");
      }
      //move motor home 
       else if (cmd == "home") {
        directions[motorIndex] = "stop";
        stopRequested[motorIndex] = false;
        long stepsToMove = -currentPosition[motorIndex];// i just changed this logic 
        Serial.print("Homing Motor ");
        Serial.print(inputMotor);
        Serial.println(" to 0...");
        moveWithStopInterrupt(motorIndex, stepsToMove);
        if (!stopRequested[motorIndex]) {
          currentPosition[motorIndex] = 0;
          savePositionsToEEPROM();
          Serial.println("Home complete.");
        }
      } else {//handels invalid commands
        Serial.println("Invalid command.");
      }
    } else {
      Serial.println("Invalid input. Format: motor#,command");
    }
  }

  for (int i = 0; i < 3; i++) {
    if (stopRequested[i]) continue;

    long newPosition = currentPosition[i];
    if (directions[i] == "c") newPosition -= 1;
    else if (directions[i] == "cc") newPosition += 1;
    else continue;

    bool outOfBounds = false;
//out of bounds for stand
    if (i == 0) {
      if (newPosition < -510 || newPosition > 510) outOfBounds = true;
    } else {
      float mmPerRevUsed = (i == 2) ? mmPerRev_M2 : mmPerRev;
      float newMM = (newPosition / (float)stepsPerRevolution) * mmPerRevUsed;
      if ((i == 1 && (newMM < mmMin_M1 || newMM > mmMax_M1)) ||
          (i == 2 && (newMM < mmMin_M2 || newMM > mmMax_M2))) {
        outOfBounds = true;
      }
    }

    if (outOfBounds) {
      stopRequested[i] = true;
      directions[i] = "stop";
      Serial.print("Motor ");
      Serial.print((i == 0) ? 3 : (i == 1) ? 1 : 2);
      Serial.println(" LIMIT REACHED – OUT OF BOUNDS");
      continue;
    }

    motors[i]->step((directions[i] == "c") ? 1 : -1);
    currentPosition[i] += (directions[i] == "c") ? -1 : 1;
  }
}

